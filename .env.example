# CloudOps Monitor 설정 예시.
# 서버에서는 deploy/scripts/deploy.sh 가 이 파일을 .env 로 복사하고 비밀키를 자동 생성한다(권한 600).
# .env 에는 비밀키·토큰이 들어가므로 git·ZIP·채팅 어디에도 올리지 않는다(.gitignore 에 포함됨).

# ── 필수 ──────────────────────────────────────────────────────────────
# 로그인 세션(JWT) 서명 키. 32자 이상 무작위 값. 비어 있거나 짧으면 백엔드가 시작을 거부한다.
# deploy.sh 가 자동으로 채운다. 직접 만들 때: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUDOPS_SECRET_KEY=

# 서비스 주소(HTTPS 인증서가 이 이름으로 발급된다). https:// 와 / 없이 이름만.
# 무료 서브도메인 예: 내이름.duckdns.org (docs/FREE_DEPLOY.md 4장)
CLOUDOPS_DOMAIN=

# ── 계정 ──────────────────────────────────────────────────────────────
# 본인 계정을 만든 뒤 false 로 바꾸고 deploy/scripts/update.sh 를 실행하면 다른 사람이 가입할 수 없다.
CLOUDOPS_ALLOW_REGISTRATION=true

# 데모 모드: true 면 '데모 서버 추가' 버튼과 가상 데이터 시뮬레이터가 켜진다(포트폴리오 시연용).
CLOUDOPS_DEMO_MODE=true

# ── 감시·보관 ─────────────────────────────────────────────────────────
# 이 시간(초) 동안 Agent 데이터가 없으면 '연결 끊김'
CLOUDOPS_OFFLINE_AFTER_SECONDS=30
# 측정값 보관 기간(일). 지난 기록은 1시간마다 자동 삭제 → 디스크가 계속 늘지 않는다.
CLOUDOPS_RETENTION_DAYS=7
# '해결된' 장애 이력 보관 기간(일). 진행 중인 장애는 지우지 않는다.
CLOUDOPS_INCIDENT_RETENTION_DAYS=365
# backups/ 에 남길 백업 개수(오래된 것부터 삭제)
CLOUDOPS_BACKUP_KEEP=14

# ── 선택: DuckDNS 자동 갱신 (deploy/scripts/duckdns-update.sh) ─────────
# DuckDNS 화면의 token. 비밀값이므로 다른 곳에 공유하지 않는다.
# CLOUDOPS_DUCKDNS_TOKEN=

# ── 고급: 보통은 바꾸지 않는다 ─────────────────────────────────────────
# 쿠키 Secure 속성. HTTPS 구성(docker-compose.https.yml)은 이 값과 상관없이 true 로 강제한다.
CLOUDOPS_COOKIE_SECURE=false

# 다른 도메인의 웹페이지에서 이 API 를 호출해야 할 때만 https:// 출처를 쉼표로 적는다.
# 비워 두면 같은 도메인의 화면에서 온 요청만 받는다(권장). 와일드카드(*)는 쓸 수 없다.
CLOUDOPS_CORS_ORIGINS=

# HTTP 포트(nginx). 서버 배포에서는 Caddy(HTTPS) 만 외부에 열리고 이 포트는 쓰이지 않는다.
# 로컬 PC 에서 docker compose up 만 할 때 http://localhost:8080 으로 접속하는 용도.
CLOUDOPS_PORT=8080
# 기본 127.0.0.1(이 컴퓨터에서만 접속). 공개 서버에서 0.0.0.0 으로 바꾸지 말 것(check.sh 가 거부).
# CLOUDOPS_BIND=127.0.0.1

# 컨테이너 내부 네트워크와 고정 주소. 서버의 다른 네트워크와 겹칠 때만 짝을 맞춰 바꾼다.
#   백엔드는 CLOUDOPS_NGINX_IP 한 주소에서 온 X-Forwarded-For 만, nginx 는 CLOUDOPS_CADDY_IP 한 주소에서 온 것만 신뢰한다.
# CLOUDOPS_APP_SUBNET=172.31.0.0/24
# CLOUDOPS_NGINX_IP=172.31.0.10
# CLOUDOPS_EDGE_SUBNET=172.30.0.0/24
# CLOUDOPS_CADDY_IP=172.30.0.2

# 로컬 시험용 Agent 컨테이너(--profile agent)를 쓸 때만. 실제 키를 이 예시 파일에 적지 말 것.
# CLOUDOPS_AGENT_KEY=
