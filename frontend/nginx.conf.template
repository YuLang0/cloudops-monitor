# 정적 파일(React 빌드 결과)을 서빙하고, /api 는 백엔드 컨테이너로 넘긴다.
# 브라우저 입장에서 화면과 API 가 같은 출처가 되므로 CORS 가 필요 없고 쿠키 인증이 단순해진다.
#
# 이 파일은 템플릿이다. 컨테이너가 시작될 때 nginx 공식 이미지의 envsubst 단계가
# ${CLOUDOPS_TRUSTED_PROXY} 만 치환해 /etc/nginx/conf.d/default.conf 를 만든다.
# (Dockerfile 의 NGINX_ENVSUBST_FILTER 로 CLOUDOPS_ 로 시작하는 변수만 치환하므로 $host 같은 nginx 변수는 그대로 남는다)

# ── 실제 사용자 IP 판별 ─────────────────────────────────────────────────────
# "신뢰하는 프록시"에서 온 연결일 때만 X-Forwarded-For 를 읽어 $remote_addr 를 실제 사용자 IP 로 바꾼다.
#   - 기본값 127.0.0.1/32 : 신뢰하는 프록시 없음. 외부에서 온 X-Forwarded-For 는 전부 무시한다. (HTTP 단독 구성)
#   - HTTPS 구성          : docker-compose.https.yml 이 Caddy 컨테이너의 고정 IP 하나만 지정한다.
# real_ip_recursive on : 헤더에 주소가 여러 개면 오른쪽부터 보면서 "신뢰하지 않는 첫 주소"를 고른다.
#   → 공격자가 헤더 앞쪽에 가짜 주소를 넣어 보내도, Caddy 가 직접 본 주소(가장 오른쪽)가 선택된다.
set_real_ip_from ${CLOUDOPS_TRUSTED_PROXY};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # 스크립트는 같은 출처의 파일만 허용(인라인 스크립트 금지). 차트 라이브러리가 인라인 style 을 쓰므로 style 만 예외.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 64k;   # API 요청 본문은 작다. 큰 요청은 받지 않는다.

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # 여기서의 $remote_addr 는 위 real_ip 규칙을 거친 값이다:
        #   신뢰하는 프록시(Caddy)를 거쳤으면 실제 사용자 IP, 아니면 nginx 에 직접 연결한 상대의 IP.
        # 클라이언트가 보낸 X-Forwarded-For 를 이어 붙이지 않고 이 값 하나로 "덮어써서" 백엔드에 넘긴다.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri /index.html;   # SPA 라우팅: /servers/3 같은 주소로 바로 들어와도 index.html 을 준다
    }
}
